  "constraints": [
    {
      "table": "activities",
      "name": "activities_candidate_id_fkey",
      "definition": "FOREIGN KEY (candidate_id) REFERENCES candidates(id) ON DELETE CASCADE"
    },
    {
      "table": "activities",
      "name": "activities_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "candidate_invitations",
      "name": "candidate_invitations_candidate_id_fkey",
      "definition": "FOREIGN KEY (candidate_id) REFERENCES candidates(id)"
    },
    {
      "table": "candidate_invitations",
      "name": "candidate_invitations_pkey",
      "definition": "PRIMARY KEY (candidate_id)"
    },
    {
      "table": "candidate_invitations",
      "name": "candidate_invitations_state_check",
      "definition": "CHECK ((state = ANY (ARRAY['pending'::text, 'sending'::text, 'sent'::text, 'review'::text, 'skipped'::text])))"
    },
    {
      "table": "candidates",
      "name": "candidates_email_key",
      "definition": "UNIQUE (email)"
    },
    {
      "table": "candidates",
      "name": "candidates_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "candidates",
      "name": "candidates_score_check",
      "definition": "CHECK (((score >= 0) AND (score <= 100)))"
