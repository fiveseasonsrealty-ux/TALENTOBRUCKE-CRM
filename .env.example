# Test branch only. Keep both switches false until explicit approval.
PEI_OUTBOUND_ENABLED=false
AUTO_INVITATIONS_ENABLED=false
# Use an isolated Supabase test project; never production for previews.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRM_USER=
CRM_PASSWORD=
RESEND_API_KEY=
CRON_SECRET=

# Disable campaign tracking in this isolated test environment.
PEI_TEST_MODE=true

# Zoho inbound receiver: keep disabled until separate test deployment is approved.
ZOHO_WEBHOOK_ENABLED=false
ZOHO_WEBHOOK_MAILBOX=info@talentobruecke.com
ZOHO_WEBHOOK_TOKEN=
# Use either a pre-provisioned signing secret, or encrypted one-time enrollment.
ZOHO_WEBHOOK_SECRET=
ZOHO_WEBHOOK_ENCRYPTION_KEY=
ZOHO_WEBHOOK_ENROLL_UNTIL=

# Dedicated Supabase test adapter requires this sender plus subject PEI-PRUEBA.
ZOHO_TEST_SENDER=

# Separate production adapter, prepared only. Do not enable during migration.
PEI_PRODUCTION_RECEIVER_ENABLED=false
PEI_PRODUCTION_REMINDERS_ENABLED=false
PEI_PRODUCTION_CRON_SECRET=
ZOHO_PRODUCTION_WEBHOOK_TOKEN=
ZOHO_PRODUCTION_WEBHOOK_SECRET=
ZOHO_PRODUCTION_ENCRYPTION_KEY=
ZOHO_PRODUCTION_ENROLL_UNTIL=
